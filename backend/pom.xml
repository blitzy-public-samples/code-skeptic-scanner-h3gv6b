<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Net-new (no source construct: the retired tree carried no dependency manifest of any kind) -
         see docs/DECISION_LOG.md DL-002, DL-003, DL-004 -->
    <!-- 3.5.16 is the final open-source release of the 3.5.x line. The support horizon and the
         upgrade plan are recorded in docs/DECISION_LOG.md DL-003. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!-- Coordinates and base package name - see docs/DECISION_LOG.md DL-002. -->
    <groupId>com.codeskeptic</groupId>
    <artifactId>code-skeptic-scanner-backend</artifactId>
    <!-- Net-new (no source construct: the retired Python tree carried no
         dependency manifest and no version). No operational file names this
         value - infrastructure/docker/Dockerfile.backend copies
         target/*.jar by wildcard and .github/workflows/cd.yml builds and pushes
         the image under a name carrying no tag - see docs/DECISION_LOG.md
         DL-102. -->
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>code-skeptic-scanner-backend</name>
    <description>Code Skeptic Scanner backend service (Java 21 / Spring Boot)</description>

    <!-- Five properties. `java.version` fixes the release the compiler targets. The four version
         properties below shadow properties `spring-boot-starter-parent:3.5.16` declares, raising four
         BOM-managed coordinates to the first patch release that carries the published fix for an
         advisory the shipped version is inside the affected range of. Every other coordinate the BOM
         manages still takes the version the BOM resolves. The advisory ranges, the departure from AAP
         section 0.5.1.2 and the obligation these four create on the next parent move are recorded in
         docs/DECISION_LOG.md DL-306, and per coordinate in DL-100, DL-101, DL-169, DL-170, DL-171 and
         DL-240 -->
    <properties>
        <java.version>21</java.version>

        <!-- 3.5.16 resolves 4.1.135.Final, which the advisory ranges of GHSA-93wv-jw9v-4972,
             GHSA-jppx-w49h-x2qq, GHSA-mvh2-crg5-v77c, GHSA-6jqx-86gh-f27w (high),
             GHSA-558v-64gr-wgg4 (high) and GHSA-c69g-56f8-xwqj (medium) all name as affected, each
             first patched in 4.1.136.Final. One property moves every io.netty artifact together,
             including the purely transitive netty-codec, netty-codec-http and netty-codec-http2 that
             no coordinate in this file names - see docs/DECISION_LOG.md DL-100, DL-306. -->
        <netty.version>4.1.136.Final</netty.version>

        <!-- 3.5.16 resolves 2.21.4, which GHSA-5gvw-p9qm-jgwh and GHSA-mhm7-754m-9p8w (both medium,
             @JsonView bypass) name as affected, first patched in 2.21.5. The property moves the whole
             Jackson BOM, so jackson-databind, jackson-core and jackson-annotations stay on one release
             train - see docs/DECISION_LOG.md DL-101, DL-306. -->
        <jackson-bom.version>2.21.5</jackson-bom.version>

        <!-- 3.5.16 resolves 42.7.11, inside the ">= 42.7.4, < 42.7.12" range of GHSA-j92g-9f8w-j867
             (high, silent SCRAM channel-binding downgrade), first patched in 42.7.12 - see
             docs/DECISION_LOG.md DL-169, DL-306. -->
        <postgresql.version>42.7.12</postgresql.version>

        <!-- 3.5.16 resolves 10.1.55, which the Apache Tomcat vendor advisories record as affected by
             CVE-2026-55956 (moderate, security constraints ignored for the default servlet),
             CVE-2026-55955, CVE-2026-55276 (fixed in 10.1.56), CVE-2026-59083 (rewrite-valve URL
             decoding) and CVE-2026-59084 (fixed in 10.1.57). 10.1.57 is the newest 10.1.x published to
             Maven Central. The property moves tomcat-embed-core, -el and -websocket together - see
             docs/DECISION_LOG.md DL-171, DL-240, DL-306. -->
        <tomcat.version>10.1.57</tomcat.version>
    </properties>

    <dependencies>
        <!-- Replaces PyPI Flask (backend/app/main.py:L1,
             backend/app/api/tweets.py:L1) and Flask-Cors
             (backend/app/main.py:L2) - see docs/DECISION_LOG.md DL-030, DL-051. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Replaces PyPI tweepy (backend/app/services/twitter_service.py:L1,
             backend/app/tasks/tweet_monitoring.py:L1) - see
             docs/DECISION_LOG.md DL-012. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Replaces PyPI SQLAlchemy (backend/app/db/database.py:L1-2,
             backend/app/db/models.py:L1-3). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Replaces PyPI Flask-JWT-Extended (backend/app/main.py:L3,
             backend/app/api/tweets.py:L2) and passlib
             (backend/app/core/security.py:L3). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Replaces PyPI pydantic (backend/app/schema/tweet.py:L1,
             backend/app/schema/response.py:L1) - see docs/DECISION_LOG.md
             DL-050. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Metadata for the @ConfigurationProperties port of
             backend/app/core/config.py:L4-15. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Replaces PyPI PyJWT (backend/app/core/security.py:L1) - see
             docs/DECISION_LOG.md DL-014. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Replaces PyPI google-cloud-language
             (backend/app/services/sentiment_analysis.py:L1) - see
             docs/DECISION_LOG.md DL-010. -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-language</artifactId>
            <version>2.96.0</version>
        </dependency>

        <!-- Replaces PyPI openai (backend/app/services/llm_service.py:L1) -
             see docs/DECISION_LOG.md DL-011. -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
            <version>4.49.0</version>
        </dependency>

        <!-- JDBC drivers for DATABASE_URL (backend/app/core/config.py:L9) -
             see docs/DECISION_LOG.md DL-028. With com.h2database:h2 below,
             these are the three vendors config/DatabaseUrlTranslator resolves a
             scheme onto. Neither carries a version: the parent BOM resolves
             them - see docs/DECISION_LOG.md DL-241. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- In-memory database for the @DataJpaTest and @SpringBootTest slices,
             and the third vendor config/DatabaseUrlTranslator resolves a scheme
             for. The BOM resolves the version - see docs/DECISION_LOG.md
             DL-009, DL-071 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Replaces PyPI pytest (backend/tests/test_api.py:L1,
             backend/tests/test_tasks.py:L1), unittest and unittest.mock
             (backend/tests/test_services.py:L1-2) and fastapi.testclient
             (backend/tests/test_api.py:L2). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Supplies the security-aware MockMvc support the @WebMvcTest slices
             use to drive the chain of DL-021; MockMvc itself arrives with
             spring-boot-starter-test above - see docs/DECISION_LOG.md
             DL-021 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Produces the executable jar infrastructure/docker/Dockerfile.backend
                 runs; the version is inherited from the parent of DL-003 - see
                 docs/DECISION_LOG.md DL-003 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
