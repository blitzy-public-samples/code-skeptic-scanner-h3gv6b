<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Code Skeptic Scanner - backend service.

      Replaces the retired Python 3.9 / Flask package that previously occupied this
      directory. There was no Python dependency manifest at all (no requirements.txt,
      pyproject.toml, Pipfile or setup.py), even though the container image, the CI
      workflow and scripts/setup_environment.sh all tried to install from one - so this
      file is a net-new artifact rather than a conversion.

      Dependency policy: inherit spring-boot-starter-parent so that the overwhelming
      majority of coordinates are BOM-managed, and pin explicitly only those artifacts
      the Spring Boot BOM does not manage. There are no "latest" or placeholder versions
      and no private repository is involved - every coordinate resolves from Maven Central
      with default settings.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/><!-- always resolve the parent from the repository -->
    </parent>

    <groupId>com.codeskeptic</groupId>
    <artifactId>code-skeptic-scanner-backend</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>code-skeptic-scanner-backend</name>
    <description>Code Skeptic Scanner backend service (Java 21 / Spring Boot)</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Explicitly pinned coordinates: not managed by the Spring Boot BOM. -->
        <jjwt.version>0.13.0</jjwt.version>
        <google-cloud-language.version>2.96.0</google-cloud-language.version>
        <openai-java.version>4.49.0</openai-java.version>
    </properties>

    <dependencies>
        <!-- ==================================================================
             Web surface: @RestController endpoints, embedded Tomcat, Jackson and
             org.springframework.web.client.RestClient (used by the Notion adapter,
             so no extra HTTP-client dependency is required).
             ================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- WebClient, for the long-lived X (Twitter) API v2 filtered stream.
             The application itself remains a servlet application; see
             spring.main.web-application-type in application.yml. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Persistence: Spring Data JPA, Hibernate ORM and HikariCP pooling. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Security: SecurityFilterChain, BCryptPasswordEncoder,
             InMemoryUserDetailsManager. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Bean Validation (Hibernate Validator). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- @ConfigurationProperties metadata generation. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================================================================
             JWT minting and parsing (explicit pins - not BOM-managed).
             ================================================================== -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================================================================
             External integrations (explicit pins - not BOM-managed).
             ================================================================== -->

        <!-- Google Cloud Natural Language: sentiment analysis. Authenticates with
             Application Default Credentials, so no API-key property is required. -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-language</artifactId>
            <version>${google-cloud-language.version}</version>
        </dependency>

        <!-- OpenAI: response generation. Official client; replaces the removed
             openai-python 0.x Completion API. -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
            <version>${openai-java.version}</version>
        </dependency>

        <!-- ==================================================================
             JDBC drivers. DATABASE_URL is a single opaque string that does not
             name a vendor at compile time, so both drivers sit on the runtime
             classpath and Hibernate detects the dialect from connection metadata.
             ================================================================== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- In-memory database used by @DataJpaTest and the integration tests, so
             that `mvn clean verify` needs no external service. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================================================================
             Test scope: JUnit Jupiter, Mockito, AssertJ, MockMvc, WebTestClient.
             ================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Produces the executable jar that the container runs, and backs
                 `mvn spring-boot:run`. Version inherited from the parent. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
