# Build the application with Maven on a Java 21 toolchain
# Pinned by patch tag and SHA-256 digest - see backend/docs/DECISION_LOG.md DL-106
# Digest of the 2026-08-04 rebuild of maven:3.9.16-eclipse-temurin-21, which is also what the
# floating maven:3.9-eclipse-temurin-21 tag resolves to - see backend/docs/DECISION_LOG.md DL-106
FROM maven:3.9.16-eclipse-temurin-21@sha256:c07f7ccfb8ca6c9fa29ee523f00afa7d2ca6132c92f8652c4aebb5ee3491f502 AS build

# Set the working directory in the container
WORKDIR /app

# Copy the Maven project descriptor into the container
COPY pom.xml .

# Download the project dependencies into the local Maven repository
RUN mvn -B dependency:go-offline

# Copy the backend source code into the container
COPY src ./src

# Build the executable jar
RUN mvn -B clean package -DskipTests

# Use an official Java runtime as the base image
# Pinned by patch tag and SHA-256 digest - see backend/docs/DECISION_LOG.md DL-106
FROM eclipse-temurin:21.0.11_10-jre@sha256:8cef5fc7bebe421363ab543a2f4db5caf7d119d8db67d56b0f56c485d2de4d55

# Java 21 runtime the container executes: Eclipse Temurin 21.0.12+8, the July 2026 critical patch
# update, taken from the Adoptium release archive. The download is pinned by release URL and verified
# against its published SHA-256 before it is unpacked; it replaces the runtime at the base image's
# own JAVA_HOME, which leaves JAVA_HOME and PATH unchanged and no earlier runtime in the layer - see
# backend/docs/DECISION_LOG.md DL-243
ARG JAVA_RUNTIME_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12%2B8/OpenJDK21U-jre_x64_linux_hotspot_21.0.12_8.tar.gz
ARG JAVA_RUNTIME_SHA256=8a379a67c91a3ae61ffb33d46e0a40c7ba35e70713c4db31cfca30492f792eff
ARG JAVA_RUNTIME_VERSION=21.0.12+8
RUN set -eu; \
    build_arch="$(uname -m)"; \
    if [ "$build_arch" != "x86_64" ]; then \
        echo "This image is built for x86_64; the pinned Java runtime archive does not match $build_arch." >&2; \
        exit 1; \
    fi; \
    curl --fail --silent --show-error --location \
        --retry 5 --retry-delay 5 --retry-connrefused \
        --connect-timeout 30 --max-time 900 \
        --output /tmp/java-runtime.tar.gz "$JAVA_RUNTIME_URL"; \
    echo "${JAVA_RUNTIME_SHA256}  /tmp/java-runtime.tar.gz" | sha256sum --check --strict -; \
    rm -rf "${JAVA_HOME:?}"; \
    mkdir -p "$JAVA_HOME"; \
    tar --extract --gzip --file /tmp/java-runtime.tar.gz --directory "$JAVA_HOME" --strip-components=1; \
    rm -f /tmp/java-runtime.tar.gz; \
    java -version 2>&1 | grep -F "$JAVA_RUNTIME_VERSION"

# Unprivileged account the application runs as, and the application directory it owns. The account
# is created exactly once - see backend/docs/DECISION_LOG.md DL-107
RUN groupadd --system --gid 10001 scanner \
    && useradd --system --uid 10001 --gid 10001 --home-dir /app --shell /usr/sbin/nologin scanner \
    && mkdir -p /app \
    && chown 0:10001 /app \
    && chmod 0750 /app

# Set the working directory in the container
WORKDIR /app

# Copy the executable jar from the build stage; root owns it and the runtime group only reads it
COPY --from=build --chown=0:10001 /app/target/*.jar app.jar

# Mode 0640: the runtime identity reads the jar and cannot rewrite it - see
# backend/docs/DECISION_LOG.md DL-107
RUN chmod 0640 /app/app.jar

# Drop root before the entrypoint runs - see backend/docs/DECISION_LOG.md DL-107
USER 10001:10001

# Expose the port that the application will run on
EXPOSE 5000

# Health probe over the configured ${PORT:-5000} listener - see backend/docs/DECISION_LOG.md DL-218
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl --silent --output /dev/null --max-time 4 \
        "http://127.0.0.1:${PORT:-5000}/tweets" || exit 1

# Set the command to run the application
# Maximum heap is 75% of container-visible memory - see backend/docs/DECISION_LOG.md DL-218
CMD ["sh", "-c", "exec java -XX:MaxRAMPercentage=75.0 -jar app.jar"]
